# Copy is optional: bin/compose regenerates .env on each run from the host.
# This file documents knobs you may set in the environment before invoking compose.
#
#   export PROJECT=/path/to/app
#   export IMAGE=alpine-mise:dev
#   export CACHE_VOLUME=alpine-mise-cache
#   ./bin/compose run --rm alpine-mise bash -l
#
# Images are local-only (compose.yml pull_policy: never). Build with bin/build
# or bin/compose build — Compose will not pull alpine-mise:dev from a registry.

IMAGE=alpine-mise:dev
IMAGE_USER=dev
# Overridden by bin/compose from id -u / id -g unless you set them first:
# DEV_UID=1000
# DEV_GID=1000
CACHE_VOLUME=alpine-mise-cache
CACHE_ROOT=/cache
# IANA timezone (bin/compose detects host via /etc/timezone, timedatectl, or localtime):
# TZ=America/Denver
# PostgreSQL client major (default from .mise.env / shell; empty skips install):
# POSTGRESQL_VERSION=18
# Absolute project path to mount at /work (bin/compose resolves PROJECT or $PWD):
# PROJECT_MOUNT=/home/you/src/my-app
# Sibling sample (optional warm target / PROJECT=…): ../alpine-sample
COMPOSE_PROJECT_NAME=alpine-mise
