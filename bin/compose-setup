#!/usr/bin/env bash
# Compose parallel is also separate commands (no flag soup).
# Prefer:
#   bin/compose build
#   bin/warm            # or bin/warm-sample
#   bin/compose-shell
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
Compose path (separate commands):

  bin/compose build       Build IMAGE via compose
  bin/warm                Warm PROJECT into volume cache
  bin/warm-sample         Warm sibling sample
  bin/compose-shell       Interactive shell

(This script only prints that flow — it does not chain steps.)
EOF
  exit 0
fi

if [[ $# -gt 0 ]]; then
  die "compose-setup takes no options (got: $*). See --help"
fi

cat <<EOF
${FLAVOR}: compose path — use separate commands:

  bin/compose build
  bin/warm              # or: bin/warm-sample
  bin/compose-shell

EOF
print_config
