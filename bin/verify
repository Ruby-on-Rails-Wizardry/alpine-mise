#!/usr/bin/env bash
# Run image self-checks (login shells + /cache layout).
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

ensure_image

what="${1:-all}"
# Runtime helpers live in /docker/bin (user-independent).
DOCKER_BIN="/docker/bin"

run_verify() {
  local script="$1"
  log "running ${script}"
  # Bypass project mount; use entrypoint override for pure image checks.
  # Do not pass USER/HOME — use the identity baked into the image at build.
  docker run --rm \
    --entrypoint "${script}" \
    -v "${CACHE_VOLUME}:/cache" \
    "${IMAGE}"
}

ensure_cache_volume

case "${what}" in
  all)
    run_verify "${DOCKER_BIN}/verify-login-shells"
    run_verify "${DOCKER_BIN}/verify-caches"
    ;;
  shells|login|login-shells)
    run_verify "${DOCKER_BIN}/verify-login-shells"
    ;;
  caches|cache)
    run_verify "${DOCKER_BIN}/verify-caches"
    ;;
  *)
    echo "Usage: $0 [all|shells|caches]" >&2
    exit 2
    ;;
esac

log "verify ok (${what})"
