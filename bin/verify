#!/usr/bin/env bash
# Run image self-checks (login shells + /cache layout).
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

ensure_image

what="${1:-all}"
# Runtime helpers live in ~/bin (seeded from home/bin/).
HOME_BIN="/home/${IMAGE_USER}/bin"

run_verify() {
  local script="$1"
  log "running ${script}"
  # Bypass project mount; use entrypoint override for pure image checks.
  # PATH includes ~/bin so short names work; absolute path is more reliable here.
  docker run --rm \
    --entrypoint "${script}" \
    -v "${CACHE_VOLUME}:/cache" \
    -e "PATH=${HOME_BIN}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    -e "HOME=/home/${IMAGE_USER}" \
    -e "USER=${IMAGE_USER}" \
    "${IMAGE}"
}

ensure_cache_volume

case "${what}" in
  all)
    run_verify "${HOME_BIN}/verify-login-shells"
    run_verify "${HOME_BIN}/verify-caches"
    ;;
  shells|login|login-shells)
    run_verify "${HOME_BIN}/verify-login-shells"
    ;;
  caches|cache)
    run_verify "${HOME_BIN}/verify-caches"
    ;;
  *)
    echo "Usage: $0 [all|shells|caches]" >&2
    exit 2
    ;;
esac

log "verify ok (${what})"
