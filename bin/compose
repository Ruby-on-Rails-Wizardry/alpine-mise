#!/usr/bin/env bash
# docker compose wrapper: writes .env (absolute PROJECT_MOUNT, …) then runs compose.
#
# Compose project name: leave unset — Docker uses the directory basename.
# Do not set COMPOSE_PROJECT_NAME unless you need a stable override.
#
# Usage:
#   bin/compose build
#   bin/compose run --rm alpine-mise bash -l
#   PROJECT=/path/to/app bin/compose run --rm alpine-mise bash -l
#
# Images are local-only (compose.yml pull_policy: never).
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

COMPOSE_FILE="${COMPOSE_FILE:-${ROOT}/compose.yml}"
ENV_FILE="${COMPOSE_ENV_FILE:-${ROOT}/.env}"

require_docker
command -v docker >/dev/null 2>&1 || die "docker not found"
docker compose version >/dev/null 2>&1 || die "docker compose plugin not available"

if [[ ! -f "${COMPOSE_FILE}" ]]; then
  die "missing ${COMPOSE_FILE}"
fi

if [[ ! -d "${PROJECT}" ]]; then
  die "PROJECT is not a directory: ${PROJECT}"
fi
PROJECT_MOUNT="$(cd "${PROJECT}" && pwd)"

tz="$(host_timezone)"
cat >"${ENV_FILE}" <<EOF
# Generated by bin/compose — do not commit (see .gitignore / compose.env.example)
IMAGE=${IMAGE}
CACHE_VOLUME=${CACHE_VOLUME}
CACHE_ROOT=${CACHE_ROOT}
TZ=${tz}
POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-}
PROJECT_MOUNT=${PROJECT_MOUNT}
EOF
# Build-args for compose build only (identity from host at build time)
if [[ -n "${IMAGE_USER:-}" ]]; then
  printf 'IMAGE_USER=%s\n' "${IMAGE_USER}" >>"${ENV_FILE}"
fi
if [[ -n "${DEV_UID:-}" ]]; then
  printf 'DEV_UID=%s\n' "${DEV_UID}" >>"${ENV_FILE}"
fi
if [[ -n "${DEV_GID:-}" ]]; then
  printf 'DEV_GID=%s\n' "${DEV_GID}" >>"${ENV_FILE}"
fi
log "wrote ${ENV_FILE} (PROJECT_MOUNT=${PROJECT_MOUNT} TZ=${tz} POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-})"

ensure_cache_volume

# shellcheck disable=SC2086
exec docker compose \
  --project-directory "${ROOT}" \
  --env-file "${ENV_FILE}" \
  -f "${COMPOSE_FILE}" \
  ${COMPOSE_OPTS:-} \
  "$@"
