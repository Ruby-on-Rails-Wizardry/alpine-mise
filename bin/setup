#!/usr/bin/env bash
# Setup is intentionally not a multi-flag kitchen sink.
# Prefer separate commands (convention over configuration):
#
#   bin/config          # optional: show deduced host values (no write required)
#   bin/build           # build IMAGE (default alpine-mise:dev) with host USER/UID/GID
#   bin/warm            # warm /cache for PROJECT (default: this tree)
#   bin/warm-sample     # warm sibling ../alpine-sample to verify warm works
#
# Then: bin/shell
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
Host flow (separate commands — no setup flags):

  bin/config          Show IMAGE, CACHE_VOLUME, USER/UID (deduced; optional)
  bin/build           Build ${IMAGE:-alpine-mise:dev} (host identity as build-args)
  bin/warm            Warm volume cache for PROJECT (default: this directory)
  bin/warm-sample     Warm sibling sample app (${SAMPLE_APP:-../alpine-sample})
  bin/shell           Interactive shell

Compose parallel: bin/compose build, PROJECT=… bin/warm, bin/compose-shell
EOF
  exit 0
fi

if [[ $# -gt 0 ]]; then
  die "setup takes no options (got: $*). See bin/setup --help"
fi

cat <<EOF
${FLAVOR}: use separate commands (no flags on setup):

  bin/config          # optional — values are deduced at build time
  bin/build           # → ${IMAGE}
  bin/warm            # this tree as /work
  bin/warm-sample     # optional: verify warm on sibling sample
  bin/shell

EOF
print_config
