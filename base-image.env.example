# Private / internal base OS image for Dockerfile FROM.
#
# Public builds (no base-image.env) default to alpine:3.22 in the Dockerfile.
# Behind the firewall, commit this file as base-image.env on GHE so everyone
# who clones the private mirror gets the same BASE_IMAGE automatically.
#
# One-time (GHE setup):
#   cp base-image.env.example base-image.env
#   # set BASE_IMAGE= to your corp registry image (proxy + VPN certs)
#   bin/private-sync    # commit + push ghe only + build
#
# Internal users after that:
#   git clone <ghe-url> && bin/build
#
# Do not push base-image.env to public github — use bin/private-sync (PRIVATE_REMOTE).
# See docs/PRIVATE-BASE.md.
#
# Examples:
#   BASE_IMAGE=registry.corp.example/alpine-vpn:latest
#   BASE_IMAGE=ghe.corp.example:5000/platform/ubuntu-proxy:24.04

BASE_IMAGE=alpine:3.22
