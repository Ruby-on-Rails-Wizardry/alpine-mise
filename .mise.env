# Project defaults for host UX + image builds (loaded by mise.toml and bin/lib.sh).
# Shell exports win over this file. Do not put secrets here — commit only safe defaults.
#
# Override for one shot:
#   POSTGRESQL_VERSION=17 task build
#   POSTGRESQL_VERSION= task build   # empty = skip client install

# Current PostgreSQL major (stable). Used as docker build-arg / compose build arg.
POSTGRESQL_VERSION=18

# Optional Dockerfile FROM override. Prefer base-image.env (committed on GHE so
# all internal clones share it). See base-image.env.example / docs/PRIVATE-BASE.md.
# BASE_IMAGE=alpine:3.22
