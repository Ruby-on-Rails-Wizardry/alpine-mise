# Classic Yarn 1.x — global defaults for the image user.
# Offline mirror under /cache (shared volume). Berry ignores this file; see .yarnrc.yml.
# YARN_CACHE_FOLDER is also set via environment.

yarn-offline-mirror "/cache/yarn"
# Keep tarballs for other projects sharing /cache/yarn (do not prune).
yarn-offline-mirror-pruning false

--install.ignore-engines true
